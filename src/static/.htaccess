Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and the apex domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.vendy\.ltd$ [NC]
RewriteRule ^ https://vendy.ltd%{REQUEST_URI} [R=301,L]

# Old WordPress page ids (?page_id=N) -> new pages
RewriteCond %{QUERY_STRING} (^|&)page_id=694(&|$)
RewriteRule ^$ /contact-us/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=696(&|$)
RewriteRule ^$ /about/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=698(&|$)
RewriteRule ^$ /our-team/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=685(&|$)
RewriteRule ^$ /resources/#faqs? [R=301,NE,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=865(&|$)
RewriteRule ^$ /resources/#vending-faqs? [R=301,NE,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=683(&|$)
RewriteRule ^$ /resources/#tutorials? [R=301,NE,L]

# Pages merged into /resources/
RewriteRule ^tutorials/?$ /resources/#tutorials [R=301,NE,L]
RewriteRule ^faqs/?$ /resources/#faqs [R=301,NE,L]
RewriteRule ^vending_details/?$ /resources/#vending-faqs [R=301,NE,L]

# Removed WordPress pages and demo content
# Empty WP page; the Resources section lives on /
RewriteRule ^resouces/?$ /resources/ [R=301,L]
RewriteRule ^(test|home-test|sample-page|home-main)(/|$) / [R=301,L]
RewriteRule ^20[0-9]{2}(/|$) / [R=301,L]
RewriteRule ^(category|author|tag)(/|$) / [R=301,L]
RewriteRule ^our-team/[^/]+/?$ /our-team/ [R=301,L]

# WordPress system endpoints: gone for good
RewriteRule ^(feed|comments|wp-admin|wp-login\.php|wp-signup\.php|xmlrpc\.php|wp-json|wp-content|wp-includes|wp-cron\.php)(/|$) - [G,L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
# CSS and JS URLs carry a content hash (?v=...), so they can be cached for a year
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
